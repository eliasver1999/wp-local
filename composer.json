{
    "name": "yourname/personalized-cards",
    "description": "WordPress plugin for personalized cards with wallet integration",
    "type": "wordpress-plugin",
    "license": "GPL-2.0-or-later",
    "require": {
        "php": ">=7.4"
    },
    "suggest": {
        "pkpass/pkpass": "^2.0 - Required for Apple Wallet integration",
        "google/apiclient": "^2.0 - Required for Google Wallet integration"
    },
    "autoload": {
        "psr-4": {
            "PersonalizedCards\\": "includes/"
        }
    }
}
